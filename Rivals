local defaultSettings = {
    ESP_Enabled = true,
    ESP_Highlight = true,
    ESP_Name = true,
    ESP_MaxDistance = 1000,
    Aimbot_Enabled = true,
    Aimbot_FOVRadius = 150,
    Aimbot_WallCheck = true,
    Aimbot_Smoothness = 0.3,
    Aimbot_MaxDistance = 1000,
    TargetPart = "Head",
    Triggerbot_Enabled = false,
    InfJump_Enabled = false,
}
local allowedSettingTypes = { boolean = true, number = true, string = true }

local function saveSettings()
    if not writefile then return end
    local serializableSettings = {}
    for key, value in pairs(defaultSettings) do
        if allowedSettingTypes[typeof(value)] then
            serializableSettings[key] = defaultSettings[key]
        end
    end
    pcall(function()
        writefile(settingsFilePath, httpService:JSONEncode(serializableSettings))
    end)
end

local settings = (function()
    local loadedSettings
    local success, result = pcall(function()
        if not isfile or not isfile(settingsFilePath) then return nil end
        local decodedSettings = httpService:JSONDecode(readfile(settingsFilePath))
        if type(decodedSettings) ~= "table" then return nil end
        for key, defaultValue in pairs(defaultSettings) do
            if decodedSettings[key] == nil then
                decodedSettings[key] = defaultValue
            end
        end
        return decodedSettings
    end)
    if success and loadedSettings then return loadedSettings end
    local copiedDefaults = {}
    for key, value in pairs(defaultSettings) do copiedDefaults[key] = value end
    return copiedDefaults
end)()

