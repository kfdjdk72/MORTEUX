local function GetClosestTarget()
    local screenCenter = Vector2.new(currentCamera.ViewportSize.X / 2, currentCamera.ViewportSize.Y / 2)
    local closestPart = nil
    local shortestDistance = math.huge

    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character and player.Character:FindFirstChild(settings.TargetPart or "Head") then
            local targetPartObj = player.Character[settings.TargetPart or "Head"]
            local playerDistance = (currentCamera.CFrame.Position - targetPartObj.Position).Magnitude

            if playerDistance <= (settings.Aimbot_MaxDistance or 500) then
                local isVisible = true
                if settings.Aimbot_WallCheck then
                    local raycastParams = RaycastParams.new()
                    local localChar = localPlayer.Character
                    if localChar then
                        raycastParams.FilterDescendantsInstances = {localChar}
                    end
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

                    local rayDirection = (targetPartObj.Position - currentCamera.CFrame.Position).Unit * playerDistance
                    local raycastResult = workspace:Raycast(currentCamera.CFrame.Position, rayDirection, raycastParams)

                    if raycastResult and not raycastResult.Instance:IsDescendantOf(player.Character) then
                        isVisible = false
                    end
                end

                if isVisible then
                    local screenPos, onScreen = currentCamera:WorldToViewportPoint(targetPartObj.Position)
                    local targetDistance = playerDistance

                    if onScreen then
                        local mouseDistance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if mouseDistance <= (settings.Aimbot_FOVRadius or 150) then
                            targetDistance = mouseDistance
                        end
                    end

                    if targetDistance < shortestDistance then
                        shortestDistance = targetDistance
                        closestPart = targetPartObj
                    end
                end
            end
        end
    end

    return closestPart
end

