-- Ana Çalışma Döngüsü (Aimbot, FOV ve ESP Yönetimi)
runService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(currentCamera.ViewportSize.X / 2, currentCamera.ViewportSize.Y / 2)
    FOVCircle.Visible = settings.Aimbot_Enabled

    -- Aimbot Çalıştırma
    if settings.Aimbot_Enabled then
        local targetPart = GetClosestTarget()
        if targetPart then
            local targetCFrame = CFrame.lookAt(currentCamera.CFrame.Position, targetPart.Position)
            local smoothness = settings.Aimbot_Smoothness or 0.3
            if smoothness > 0 then
                currentCamera.CFrame = currentCamera.CFrame:Lerp(targetCFrame, 1 - smoothness)
            else
                currentCamera.CFrame = targetCFrame
            end
        end
    end

    -- ESP Yönetimi (Highlight ve İsimler)
    for _, player in pairs(players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            -- Highlight (Kutu / Model Aydınlatma)
            if settings.ESP_Enabled and settings.ESP_Highlight then
                local highlight = char:FindFirstChild("SynioxHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "SynioxHighlight"
                    highlight.FillColor = Color3.fromRGB(220, 20, 30)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.Parent = char
                end
            else
                local highlight = char:FindFirstChild("SynioxHighlight")
                if highlight then highlight:Destroy() end
            end

            -- İsim Etiketi (Name Tag)
            if settings.ESP_Enabled and settings.ESP_Name and hrp then
                local billboard = char:FindFirstChild("SynioxBillboard")
                if not billboard then
                    billboard = Instance.new("BillboardGui")
                    billboard.Name = "SynioxBillboard"
                    billboard.Size = UDim2.new(0, 100, 0, 40)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = char

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Name = "NameTag"
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextSize = 12
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.Text = player.Name
                    textLabel.Parent = billboard
                end
            else
                local billboard = char:FindFirstChild("SynioxBillboard")
                if billboard then billboard:Destroy() end
            end
        end
    end
end)
