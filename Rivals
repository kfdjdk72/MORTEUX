local function applySelectedSkin(skinName)
    if not skinName or skinName == "Hiçbiri" then return end
    task.spawn(function()
        pcall(function()
            local pdc = require(localPlayer:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("PlayerDataController"))
            if pdc and pdc.CurrentData then
                local inv = pdc.CurrentData:Get("CosmeticInventory")
                if inv then inv[skinName] = true end
            end
        end)
    end)
end

local function applyAllSkinsNonBlocking()
    task.spawn(function()
        pcall(function()
            local pdc = require(localPlayer:WaitForChild("PlayerScripts"):WaitForChild("Controllers"):WaitForChild("PlayerDataController"))
            if pdc and pdc.CurrentData and lib and lib.Cosmetics then
                local inv = pdc.CurrentData:Get("CosmeticInventory")
                if inv then
                    local count = 0
                    for name, _ in pairs(lib.Cosmetics) do
                        inv[name] = true
                        count = count + 1
                        if count % 15 == 0 then task.wait() end
                    end
                end
            end
        end)
    end)
end

