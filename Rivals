local slots = { Skin = true, Wrap = true, Charm = true, Finisher = true }
local added = {}
local saved = {}
local alive = true
local swaps = {}
local swapping = {}
local moduleCache = {}
local modelCache = {}
local oldGet = replicated and replicated.Get or function() end
local oldVmGet = vmClass and rawget(vmClass, "Get") or function() end

if lib and pdc then
    local function get(key)
        local ok, v = pcall(pdc.CurrentData.Get, pdc.CurrentData, key)
        return ok and v or nil
    end

    waitFor(function() return get("CosmeticInventory") and get("WeaponInventory") end)

    local function flush()
        pcall(function()
            if not isfolder(cosmeticsFolder) then
                makefolder(cosmeticsFolder)
            end
            writefile(cosmeticsFile, httpService:JSONEncode(saved))
        end)
    end

    local function find(weapon)
        local list = get("WeaponInventory")
        if not list then return end
        for _, w in pairs(list) do
            if w.Name == weapon then
                return w
            end
        end
    end

    local inv = get("CosmeticInventory")
    for name in pairs(lib.Cosmetics) do
        if inv and inv[name] == nil then
            inv[name] = true
            added[name] = true
        end
    end

    pcall(function()
        if isfile(cosmeticsFile) then
            saved = httpService:JSONDecode(readfile(cosmeticsFile))
        end
    end)

    local function baseOf(name)
        local cosmetic = lib.Cosmetics[name]
        if cosmetic and cosmetic.Type == "Skin" and cosmetic.ItemName then
            return cosmetic.ItemName
        end
        return name
    end

    local function moduleOf(name)
        local cached = moduleCache[name]
        if cached == nil then
            local found = classes:FindFirstChild(name, true)
            cached = found and found:IsA("ModuleScript") and found or false
            moduleCache[name] = cached
        end
        return cached or nil
    end

    local function hasModel(name)
        local cached = modelCache[name]
        if cached == nil then
            cached = viewModels:FindFirstChild(name, true) ~= nil
            modelCache[name] = cached
        end
        return cached
    end

    local function skinClassFor(weapon, skin)
        local defaultModule = moduleOf(weapon)
        local skinModule = skin and moduleOf(skin.Name)
        if not (defaultModule and skinModule and hasModel(skin.Name)) then return end
        if skinModule.Parent ~= defaultModule.Parent and skinModule.Parent ~= defaultModule then return end
        local loaded, skinClass = pcall(require, skinModule)
        if loaded and type(skinClass) == "table" and type(skinClass.new) == "function" then
            return skinClass
        end
    end

    local function wantedSkin(weapon)
        local picks = saved[weapon]
        local skin = picks and picks.Skin
        if not skin then return false end
        if skinClassFor(weapon, skin) or (not moduleOf(skin.Name) and hasModel(skin.Name)) then
            return skin.Name
        end
        return false
    end

    local function installSwap(weapon)
        if swaps[weapon] then return end
        local defaultModule = moduleOf(weapon)
        if not defaultModule then return end
        local ok, class = pcall(require, defaultModule)
        if not ok or type(class) ~= "table" or type(class.new) ~= "function" then return end
        local origNew = class.new
        swaps[weapon] = { class = class, origNew = origNew, own = rawget(class, "new") ~= nil }
        class.new = function(...)
            local thread = coroutine.running()
            local mine = alive and not swapping[thread]
            local picks = mine and saved[weapon]
            local skin = picks and picks.Skin
            local skinClass = skin and skinClassFor(weapon, skin)
            if skinClass then
                swapping[thread] = { weapon = weapon, skin = skin.Name }
                local built, object = pcall(skinClass.new, ...)
                swapping[thread] = nil
                if built then
                    if type(object) == "table" then
                        rawset(object, "_rivalsSkin", skin.Name)
                    end
                    return object
                end
            end
            local object = origNew(...)
            if mine and type(object) == "table" then
                rawset(object, "_rivalsSkin", not skinClass and wantedSkin(weapon))
            end
            return object
        end
    end

    for weapon, picks in pairs(saved) do
        if picks.Skin then
            installSwap(weapon)
        end
    end

    if replicated then
        replicated.Get = function(self, key)
            if alive and slots[key] then
                local data = rawget(self, "Data")
                local picks = data and saved[baseOf(data.Name)]
                local entry = picks and picks[key]
                if entry ~= nil then
                    return entry
                end
            end
            return oldGet(self, key)
        end
    end

    if vmClass then
        vmClass.Get = function(self, key)
            if alive and key == "Name" then
                local data = rawget(self, "Data")
                if data then
                    local weapon = baseOf(data.Name)
                    local active = swapping[coroutine.running()]
                    if active and active.weapon == weapon then
                        return active.skin
                    end
                    local picks = saved[weapon]
                    local skin = picks and picks.Skin
                    if skin and not moduleOf(skin.Name) and hasModel(skin.Name) and (data.Name == weapon or not moduleOf(data.Name)) then
                        return skin.Name
                    end
                end
            end
            return (oldVmGet or replicated.Get)(self, key)
        end
    end
end

